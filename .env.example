# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MCP Standards Server ──────────────────────────────────────────────────────
# URL of the local MCP HTTP server (default: http://localhost:5002/mcp)
# Only change this if you run the server on a different host/port.
# MCP_URL=http://localhost:5002/mcp

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
# Persistent directory for ChromaDB (default: ./data/chroma)
# CHROMA_PATH=./data/chroma

# Collection name used for contract chunks (default: legal_contracts)
# COLLECTION_NAME=legal_contracts

# ── Retrieval ─────────────────────────────────────────────────────────────────
# BM25 corpus cache file (default: ./data/bm25_corpus.json)
# BM25_CORPUS_PATH=./data/bm25_corpus.json

# ── Logging ───────────────────────────────────────────────────────────────────
# Log files are written to ./data/logs/ — no env var needed unless you move them.
